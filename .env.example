# Postgres URL from Vercel Storage (Neon, Supabase, or other).
# Prefer the pooled POSTGRES_URL on Vercel; POSTGRES_URL_NON_POOLING is a fallback.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=

# Set to "http" after the database is linked so the app uses /api/family.
# Leave unset to keep the in-memory + localStorage client.
VITE_FAMILY_API=
